# DeepTier Docker Compose Environment Template
# Copy to .env in the repo root before running: docker compose up --build

# --- PostgreSQL ---
DB_NAME=deeptier
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Shared Java <-> Python Internal Auth ---
DEEPTIER_INTERNAL_KEY=dt-internal-dev-key-2026

# --- Java dt-backend (Port 8080) ---
DEEPTIER_AUTH_ENABLED=true
DEEPTIER_JWT_SECRET=deeptier-dev-jwt-secret-change-in-prod-2026-min-32-bytes
DEEPTIER_JWT_EXPIRATION_SECONDS=86400
DEEPTIER_DEMO_RESET_ENABLED=true
DEEPTIER_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional Live SAP S/4HANA Push (leave blank for simulated_s4hana mode) ---
S4HANA_BASE_URL=
S4HANA_USERNAME=
S4HANA_PASSWORD=
S4HANA_BEARER_TOKEN=

# --- Python AI Service (Port 8000) ---
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=10000
TRADEPILOT_ANALYST_KEY=
LOG_LEVEL=INFO
