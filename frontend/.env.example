# Public backend origin only, no trailing slash or /api suffix.
# Set this as a Config variable in Vercel; must use HTTPS.
VITE_API_ORIGIN=https://your-backend.example.com

# Legacy alias; VITE_API_ORIGIN takes precedence when both are set.
VITE_API_BASE_URL=

# Used only by the Vite development proxy.
VITE_BACKEND_URL=http://127.0.0.1:8080
